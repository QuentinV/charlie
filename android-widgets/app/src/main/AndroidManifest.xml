<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".CharlieWidgetApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CharlieWidgets"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Settings Activity -->
        <activity
            android:name=".settings.SettingsActivity"
            android:exported="true"
            android:label="@string/settings_title">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Single Device Widget Configuration -->
        <activity
            android:name=".widget.single.SingleDeviceConfigActivity"
            android:exported="true"
            android:label="@string/widget_single_config_title"
            android:theme="@style/Theme.CharlieWidgets.Dialog">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Multi Device Widget Configuration -->
        <activity
            android:name=".widget.multi.MultiDeviceConfigActivity"
            android:exported="true"
            android:label="@string/widget_multi_config_title"
            android:theme="@style/Theme.CharlieWidgets.Dialog">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Single Device Widget (only needs APPWIDGET_UPDATE; toggle/open use explicit intents) -->
        <receiver
            android:name=".widget.single.SingleDeviceWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_single_device_info" />
        </receiver>

        <!-- Multi Device Widget -->
        <receiver
            android:name=".widget.multi.MultiDeviceWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_multi_device_info" />
        </receiver>

        <!-- RemoteViewsService for Multi Device Widget list -->
        <service
            android:name=".widget.multi.MultiDeviceViewsService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

    </application>

</manifest>