    "recipeIngredient":  [
                             "1 poulet coupé en 6 morceaux",
                             "1 kg de tomate",
                             "700 g de poivrons (verts et rouges)",
                             "3 oignons émincés",
                             "3 gousses d\u0027ail",
                             "20 cl de vin blanc",
                             "1 bouquet garni",
                             "6 cuillères à soupe d\u0027huile d\u0027olive",
                             "sel",
                             "poivre"
                         ],
    "recipeInstructions":  [
                               {
                                   "@type":  "HowToStep",
                                   "text":  "Hacher l\u0027oignon et l\u0027ail. Couper les tomates en morceaux et détailler les poivrons en lanières."
                               },
                               {
                                   "@type":  "HowToStep",
                                   "text":  "Faire chauffer 4 cuillères à soupe d\u0027huile dans une cocotte. Y faire dorer les oignons, l\u0027ail et les poivron. Laisser cuire 5 min."
                               },
                               {
                                   "@type":  "HowToStep",
                                   "text":  "Ajouter les tomates à la cocotte, saler, poivrer. Couvrir et laisser mijoter 20 min."
                               },
                               {
                                   "@type":  "HowToStep",
                                   "text":  "Dans une sauteuse, faire dorer dans l\u0027huile d\u0027olive les morceaux de poulet salés et poivrés. "
                               },
                               {
                                   "@type":  "HowToStep",
                                   "text":  "Lorsqu\u0027ils sont dorés, les ajouter aux légumes, couvrir, ajouter le bouquet garni et le vin blanc et c\u0027est parti pour 35 min de cuisson."
                               }
                           ],
